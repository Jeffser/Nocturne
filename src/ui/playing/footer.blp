using Gtk 4.0;
using Adw 1;

template $NocturnePlayingFooter: Adw.BreakpointBin {
  width-request: 360;
  height-request: 32;
  Adw.Breakpoint {
    condition ("max-width: 480sp")
    setters {
      previous_el.visible: false;
      next_el.visible: false;
    }
  }

  child: Gtk.Box {
    valign: start;
    orientation: horizontal;
    spacing: 10;
    styles [
      "p10"
    ]

    Gtk.Box {
      orientation: horizontal;
      spacing: 10;
      hexpand: true;

      Gtk.Image cover_el {
        styles [
          "card"
        ]
        accessibility {
          label: _("Current song cover art");
        }
        icon-name: "music-note-symbolic";
        height-request: bind $format_cover_art_size(template.forceHugeMode);
        width-request: bind $format_cover_art_size(template.forceHugeMode);
        pixel-size: bind $format_cover_art_pixel_size(template.forceHugeMode, cover_el.paintable);
        paintable: bind $format_cover_art_paintable(template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .songId);
        overflow: hidden;
        valign: center;
      }

      Gtk.Box detail_container {
        orientation: vertical;
        spacing: 5;
        valign: center;
        hexpand: true;

        Gtk.Label title_el {
          styles [
            "title-4"
          ]
          xalign: 0;
          halign: start;
          ellipsize: end;
          label: bind template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .displaySongTitle;
        }

        Gtk.Label artist_el {
          styles [
            "dimmed"
          ]
          xalign: 0;
          halign: start;
          ellipsize: end;
          label: bind template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .displaySongArtist;
        }

        Gtk.Scale progress_el {
          styles [
            "p0"
          ]
          adjustment: Gtk.Adjustment {
            lower: 0;
            upper: bind template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .currentSong as <$NocturneModelSong> .duration;
            value: bind template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .positionSeconds;
          };
          visible: bind $format_progress_el_visibility(template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .songId);
          change-value => $progress_bar_changed();
        }
      }
    }

    Gtk.Button previous_el {
      icon-name: "media-skip-backward-symbolic";
      valign: center;
      action-name: "app.player_previous";
      tooltip-text: _("Previous");
      styles [
        "circular"
      ]
    }

    Gtk.Stack state_stack_el {
      transition-type: crossfade;
      visible-child-name: bind template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .buttonState;

      Gtk.StackPage {
        name: "play";
        child: Gtk.Button {
          icon-name: "media-playback-start-symbolic";
          valign: center;
          action-name: "app.player_play";
          tooltip-text: _("Play");
          styles [
            "circular",
            "accent",
            "color"
          ]
        };
      }

      Gtk.StackPage {
        name: "pause";
        child: Gtk.Button {
          icon-name: "media-playback-pause-symbolic";
          valign: center;
          action-name: "app.player_pause";
          tooltip-text: _("Pause");
          styles [
            "circular",
            "accent",
            "color"
          ]
        };
      }
    }

    Gtk.Button next_el {
      icon-name: "media-skip-forward-symbolic";
      valign: center;
      action-name: "app.player_next";
      tooltip-text: _("Next");
      styles [
        "circular"
      ]
    }
  };
}