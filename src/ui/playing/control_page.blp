using Gtk 4.0;
using Adw 1;

template $NocturnePlayingControlPage: Adw.NavigationPage {
  title: _("Playing");
  tag: "playing";
  child: Adw.ToolbarView {
    extend-content-to-top-edge: true;

    [top]
    Adw.HeaderBar header_bar {
      show-title: false;
      show-end-title-buttons: false;
      show-start-title-buttons: false;
    }

    content: Gtk.ScrolledWindow {
      propagate-natural-height: true;
      propagate-natural-width: false;
      hscrollbar-policy: never;

      child: Adw.Clamp clamp {
        maximum-size: 720;
        styles [
          "p0"
        ]

        child: Gtk.Box main_container {
          orientation: vertical;
          vexpand: true;
          valign: center;
          spacing: 15;
          styles [
            "p10"
          ]

          Adw.Bin {
            child: bind template.extra-widget;
          }

          $NocturnePlayingCoverArt cover_art_el {
            margin-bottom: 10;
          }

          Gtk.Box {
            orientation: vertical;
            spacing: 10;

            Gtk.Label title_el {
              wrap: true;
              wrap-mode: word_char;
              lines: 2;
              ellipsize: end;
              justify: center;
              label: bind template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .displaySongTitle;
              tooltip-text: bind template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .displaySongTitle;
              styles [
                "title-1"
              ]
            }

            Adw.WrapBox {
              child-spacing: 5;
              line-spacing: 5;
              justify: fill;
              sensitive: bind $format_to_bool(
                template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .currentSong as <$NocturneModelSong> .isExternalFile,
                true
              );

              Gtk.Button artist_el {
                halign: center;
                hexpand: true;
                action-target: bind $format_action_target(
                  template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .currentSong as <$NocturneModelSong> .artistId,
                  's'
                );
                action-name: bind $format_show_artist(template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .currentSong as <$NocturneModelSong> .radioStreamUrl);
                tooltip-text: bind template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .displaySongArtist;
                sensitive: bind $format_to_bool(
                  template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .currentSong as <$NocturneModelSong> .radioStreamUrl,
                  true
                );
                visible: bind $format_to_bool(
                  template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .displaySongArtist,
                  false
                );
                child: Gtk.Label {
                  ellipsize: end;
                  label: bind template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .displaySongArtist;
                };
                styles [
                  "flat",
                  "dimmed",
                  "p0"
                ]
              }

              Gtk.Button radio_homepage_el {
                halign: center;
                hexpand: true;
                action-target: bind $format_radio_homepage(
                  template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .currentSong as <$NocturneModelSong> .radioStreamUrl,
                  true
                );
                action-name: "app.visit_url";
                visible: bind $format_to_bool(
                  template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .currentSong as <$NocturneModelSong> .radioStreamUrl,
                  false
                );
                tooltip-text: bind $format_radio_homepage(
                  template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .currentSong as <$NocturneModelSong> .radioStreamUrl,
                  false
                );
                child: Adw.ButtonContent {
                  icon-name: "external-link-symbolic";
                  label: bind $format_radio_homepage(
                    template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .currentSong as <$NocturneModelSong> .radioStreamUrl,
                    false
                  );
                };
                styles [
                  "flat",
                  "dimmed",
                  "p0"
                ]
                accessibility {
                  label: _("Visit current radio homepage");
                }
              }

              Gtk.Button album_el {
                halign: center;
                hexpand: true;
                action-target: bind $format_action_target(
                  template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .currentSong as <$NocturneModelSong> .albumId,
                  's'
                );
                action-name: "app.show_album";
                tooltip-text: bind template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .currentSong as <$NocturneModelSong> .album;
                visible: bind $format_to_bool(
                  template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .currentSong as <$NocturneModelSong> .album,
                  false
                );
                child: Gtk.Label {
                  ellipsize: end;
                  label: bind template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .currentSong as <$NocturneModelSong> .album;
                };
                styles [
                  "flat",
                  "dimmed",
                  "p0"
                ]
              }
            }

            Gtk.Scale progress_el {
              orientation: horizontal;
              change-value => $progress_bar_changed();
              visible: bind $format_to_bool(
                template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .currentSong as <$NocturneModelSong> .radioStreamUrl,
                true
              );
              adjustment: Gtk.Adjustment {
                lower: 0;
                upper: bind template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .currentSong as <$NocturneModelSong> .duration;
                value: bind template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .positionSeconds;
              };
              styles [
                "p0"
              ]
              accessibility {
                label: _("Current song progress bar");
              }
            }

            Gtk.Box {
              visible: bind $format_to_bool(
                template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .currentSong as <$NocturneModelSong> .radioStreamUrl,
                true
              );

              Gtk.Label positive_progress_el {
                styles [
                  "numeric",
                  "dimmed"
                ]
                xalign: 0;
                justify: left;
                hexpand: true;
                label: bind $format_progress_label(
                  template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .positionSeconds,
                  template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .currentSong as <$NocturneModelSong> .duration,
                  false
                );
              }
              Gtk.Label negative_progress_el {
                styles [
                  "numeric",
                  "dimmed"
                ]
                xalign: 1;
                justify: right;
                hexpand: true;
                label: bind $format_progress_label(
                  template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .positionSeconds,
                  template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .currentSong as <$NocturneModelSong> .duration,
                  true
                );
              }
            }

            Gtk.Box {
              orientation: horizontal;
              spacing: 15;
              hexpand: true;
              halign: center;

              Gtk.Button {
                icon-name: "media-skip-backward-symbolic";
                valign: center;
                action-name:"app.player_previous";
                tooltip-text: _("Previous");
                styles [
                  "circular"
                ]
              }

              Gtk.Stack state_stack_el {
                transition-type: crossfade;
                visible-child-name: bind template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .buttonState;

                Gtk.StackPage {
                  name: "play";
                  child: Gtk.Button {
                    icon-name: "media-playback-start-symbolic";
                    valign: center;
                    action-name:"app.player_play";
                    tooltip-text: _("Play");
                    styles [
                      "circular",
                      "accent",
                      "color"
                    ]
                  };
                }

                Gtk.StackPage {
                  name: "pause";
                  child: Gtk.Button {
                    icon-name: "media-playback-pause-symbolic";
                    valign: center;
                    action-name: "app.player_pause";
                    tooltip-text: _("Pause");
                    styles [
                      "circular",
                      "accent",
                      "color"
                    ]
                  };
                }
              }

              Gtk.Button {
                icon-name: "media-skip-forward-symbolic";
                valign: center;
                action-name: "app.player_next";
                tooltip-text: _("Next");
                styles [
                  "circular"
                ]
              }
            }

            Gtk.Box {
              orientation: horizontal;
              halign: center;
              styles [
                "toolbar"
              ]

              $NocturnePlaybackModeButton {}

              $NocturneVolumeButton {}

              Gtk.MenuButton rating_button {
                icon-name: bind $format_rating_icon_name(
                  template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .currentSong as <$NocturneModelSong> .userRating,
                  1
                );
                tooltip-text: _("Rate");
                visible: bind $format_to_bool(
                  template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .currentSong as <$NocturneModelSong> .radioStreamUrl,
                  true
                );
                popover: Gtk.Popover {
                  child: Gtk.Box rating_container {
                    hexpand: true;
                    halign: center;
                    visible: bind $format_all_false(
                      template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .currentSong as <$NocturneModelSong> .radioStreamUrl,
                      template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .currentSong as <$NocturneModelSong> .isExternalFile
                    );
                    Gtk.Button {
                      name: "1";
                      tooltip-text: _("1 Star");
                      icon-name: bind $format_rating_icon_name(
                        template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .currentSong as <$NocturneModelSong> .userRating,
                        1
                      );
                      clicked => $change_rating();
                      styles [
                        "flat"
                      ]
                    }
                    Gtk.Button {
                      name: "2";
                      tooltip-text: _("2 Stars");
                      icon-name: bind $format_rating_icon_name(
                        template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .currentSong as <$NocturneModelSong> .userRating,
                        2
                      );
                      clicked => $change_rating();
                      styles [
                        "flat"
                      ]
                    }
                    Gtk.Button {
                      name: "3";
                      tooltip-text: _("3 Stars");
                      icon-name: bind $format_rating_icon_name(
                        template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .currentSong as <$NocturneModelSong> .userRating,
                        3
                      );
                      clicked => $change_rating();
                      styles [
                        "flat"
                      ]
                    }
                    Gtk.Button {
                      name: "4";
                      tooltip-text: _("4 Stars");
                      icon-name: bind $format_rating_icon_name(
                        template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .currentSong as <$NocturneModelSong> .userRating,
                        4
                      );
                      clicked => $change_rating();
                      styles [
                        "flat"
                      ]
                    }
                    Gtk.Button {
                      name: "5";
                      tooltip-text: _("5 Stars");
                      icon-name: bind $format_rating_icon_name(
                        template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .currentSong as <$NocturneModelSong> .userRating,
                        5
                      );
                      clicked => $change_rating();
                      styles [
                        "flat"
                      ]
                    }
                  };
                };
              }

              Gtk.Button star_el {
                icon-name: bind $format_starred_icon_name(template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .currentSong as <$NocturneModelSong> .starred);
                tooltip-text: _("Star");
                action-target: bind $format_action_target(template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .songId, 's');
                action-name: "app.toggle_star";
                visible: bind $format_all_false(
                  template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .currentSong as <$NocturneModelSong> .radioStreamUrl,
                  template.root as <$NocturneWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .currentSong as <$NocturneModelSong> .isExternalFile
                );
              }

              Gtk.Button show_sidebar_el {
                icon-name: "sidebar-show-right-symbolic";
                tooltip-text: _("Toggle Sidebar");
                clicked => $show_content_clicked();
              }
            }
          }
        };
      };
    };
  };
}