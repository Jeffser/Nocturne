using Gtk 4.0;
using Adw 1;

template $NocturnePlayingQueuePage: Gtk.ScrolledWindow {
  propagate-natural-width: true;
  propagate-natural-height: true;
  max-content-width: 500;
  max-content-height: 400;
  child: Adw.Clamp {
    maximum-size: 800;
    tightening-threshold: 600;
    child: Gtk.Box {
      orientation: vertical;
      spacing: 5;

      Gtk.Box {
        orientation: horizontal;
        spacing: 12;
        margin-start: 12;
        margin-end: 12;

        Gtk.Box {
          orientation: vertical;
          hexpand: true;
          valign: center;
          spacing: 2;

          Gtk.Label {
            label: _("Autoplay");
            xalign: 0;
          }

          Gtk.Label {
            label: _("Generate a new queue when the current one ends");
            xalign: 0;
            wrap: true;

            styles [
              "dim-label",
              "caption",
            ]
          }
        }

        Gtk.Stack loading_stack{
          valign: center;
          transition-type: crossfade;
          transition-duration: 150;
          visible-child-name: bind $format_loading_stack(template.root as <Adw.ApplicationWindow> .application as <$NocturneApplication> .player as <$NocturnePlayer> .generatingQueue);

          Gtk.StackPage {
            name: "switch";
            child: Gtk.Switch autoplay_switch_el {
              valign: center;
            };
          }

          Gtk.StackPage {
            name: "spinner";
            child: Adw.Spinner {
              tooltip-text: _("Generating Next Queue");
              valign: center;
            };
          }
        }
      }

      Adw.Bin list_bin_el {
        child: $NocturneSongQueue song_list_el {
          styles [
            "p10"
          ]
        };
      }
    };
  };
}