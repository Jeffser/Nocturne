using Gtk 4.0;
using Adw 1;

template $NocturneAlbumButton: Gtk.Box {
  orientation: vertical;
  spacing: 5;
  halign: center;
  name: bind template.model as <$NocturneModelAlbum> .name;

  Gtk.Overlay {
    styles [
      "album-button"
    ]

    [overlay]
    Gtk.Button play_el {
      icon-name: "media-playback-start-symbolic";
      styles [
        "circular",
        "osd"
      ]
      tooltip-text: _("Play Album");
      action-name: "app.play_album";
      action-target: bind $format_action_target(template.model as <$NocturneModelAlbum> .id, 's');
      valign: end;
      halign: start;
    }

    [overlay]
    Gtk.Button star_el {
      styles [
        "circular",
        "osd"
      ]
      accessibility {
        label: _("Toggle star");
      }

      action-name: "app.toggle_star";
      action-target: bind $format_action_target(template.model as <$NocturneModelAlbum> .id, 's');
      icon-name: bind $format_starred_icon_name(template.model as <$NocturneModelAlbum> .starred);
      tooltip-text: bind $format_starred_tooltip_text(template.model as <$NocturneModelAlbum> .starred);
      valign: end;
      halign: end;
    }

    child: Gtk.Button cover_button_el {
      styles [
        "force_p0",
        "flat"
      ]
      action-name: "app.show_album";
      action-target: bind $format_action_target(template.model as <$NocturneModelAlbum> .id, 's');
      halign: center;
      tooltip-text: bind template.model as <$NocturneModelAlbum> .name;

      child: Gtk.Image cover_el {
        styles [
          "card"
        ]
        icon-size: large;
        overflow: hidden;
        hexpand: true;
        icon-name: "music-queue-symbolic";
        paintable: bind $format_gdkPaintable(template.model as <$NocturneModelAlbum> .gdkPaintable);
        accessibility {
          label: _("Album cover art");
        }
      };
      Gtk.GestureClick {
        button: 3;
        released => $show_popover_image();
      }
      Gtk.GestureLongPress {
        pressed => $show_popover_image();
      }
    };
  }

  Gtk.Button name_button_el {
    Gtk.GestureClick {
      button: 3;
      released => $show_popover_name();
    }
    Gtk.GestureLongPress {
      pressed => $show_popover_name();
    }
    styles [
      "flat",
      "p0"
    ]
    accessibility {
      label: _("Enter album page");
    }

    child: Gtk.Box{
      orientation: vertical;
      spacing: 6;

      Gtk.Label name_el {
        styles [
          "title-3"
        ]
        ellipsize: end;
        max-width-chars: 1;
        label: bind template.model as <$NocturneModelAlbum> .name;
      }
      Gtk.Label year_el {
        styles [
          "dimmed"
        ]
        visible: false;
        ellipsize: end;
        max-width-chars: 1;
        label: bind template.model as <$NocturneModelAlbum> .year;
      }
    };

    action-name: "app.show_album";
    action-target: bind $format_action_target(template.model as <$NocturneModelAlbum> .id, 's');
    tooltip-text: bind template.model as <$NocturneModelAlbum> .name;
  }

  Gtk.Button artist_el {
    Gtk.GestureClick {
      button: 3;
      released => $show_popover_artist();
    }
    Gtk.GestureLongPress {
      pressed => $show_popover_artist();
    }
    styles [
      "dimmed",
      "flat",
      "p0"
    ]
    accessibility {
      label: _("Enter artist page");
    }

    tooltip-text: bind template.model as <$NocturneModelAlbum> .artist;
    action-name: "app.show_artist";
    action-target: bind $format_action_target(template.model as <$NocturneModelAlbum> .artistId, 's');

    child: Gtk.Label {
      ellipsize: end;
      max-width-chars: 1;
      label: bind template.model as <$NocturneModelAlbum> .artist;
    };
  }
}