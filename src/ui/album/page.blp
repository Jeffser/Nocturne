using Gtk 4.0;
using Adw 1;

template $NocturneAlbumPage: Adw.NavigationPage {
  title: bind template.model as <$NocturneModelAlbum> .name;
  name: bind template.model as <$NocturneModelAlbum> .name;
  child: Adw.ToolbarView {
    extend-content-to-top-edge: true;

    [top]
    Adw.HeaderBar {
      show-title: false;
    }

    content: Gtk.ScrolledWindow {
      propagate-natural-width: true;
      propagate-natural-height: true;

      child: Adw.Clamp clamp_el {
        tightening-threshold: 800;
        maximum-size: 2000;

        child: Gtk.Box {
          styles [
            "p10"
          ]
          orientation: vertical;
          spacing: 10;

          Adw.WrapBox { // Information Container
            margin-top: 40;
            orientation: horizontal;
            line-spacing: 10;
            child-spacing: 10;
            justify: fill;
            wrap-policy: minimum;

            Gtk.Image cover_el {
              styles [
                "card"
              ]
              accessibility {
                label: _("Album cover art");
              }
              icon-size: large;
              height-request: 240;
              width-request: 240;
              overflow: hidden;
              halign: center;
              valign: start;
              pixel-size: bind $format_cover_pixel_size(template.model as <$NocturneModelAlbum> .gdkPaintable);
              paintable: bind template.model as <$NocturneModelAlbum> .gdkPaintable;
              icon-name: "music-queue-symbolic";
            }

            Gtk.Box {
              orientation: vertical;
              spacing: 10;
              valign: center;

              Gtk.Label name_el {
                styles [
                  "big-album-title"
                ]
                xalign: 0;
                wrap: true;
                wrap-mode: word_char;
                lines: 2;
                halign: start;
                ellipsize: end;
                valign: center;
                label: bind template.model as <$NocturneModelAlbum> .name;
                visible: bind $format_to_bool(template.model as <$NocturneModelAlbum> .name);
              }

              Gtk.Button artist_el {
                styles [
                  "flat",
                  "dimmed",
                  "p0"
                ]
                accessibility {
                  label: _("Enter artist page");
                }

                halign: start;
                valign: center;
                action-name: "app.show_artist";
                action-target: bind $format_action_target(template.model as <$NocturneModelAlbum> .artistId, 's');
                label: bind template.model as <$NocturneModelAlbum> .artist;
                tooltip-text: bind template.model as <$NocturneModelAlbum> .artist;
                visible: bind $format_to_bool(template.model as <$NocturneModelAlbum> .artist);
              }

              Gtk.Box rating_container {
                styles [
                  "linked"
                ]
                Gtk.Button {
                  name: "1";
                  tooltip-text: _("1 Star");
                  icon-name: bind $format_rating_icon_name(template.model as <$NocturneModelAlbum> .userRating, 1);
                  clicked => $change_rating();
                  styles [
                    "flat"
                  ]
                }
                Gtk.Button {
                  name: "2";
                  tooltip-text: _("2 Stars");
                  icon-name: bind $format_rating_icon_name(template.model as <$NocturneModelAlbum> .userRating, 2);
                  clicked => $change_rating();
                  styles [
                    "flat"
                  ]
                }
                Gtk.Button {
                  name: "3";
                  tooltip-text: _("3 Stars");
                  icon-name: bind $format_rating_icon_name(template.model as <$NocturneModelAlbum> .userRating, 3);
                  clicked => $change_rating();
                  styles [
                    "flat"
                  ]
                }
                Gtk.Button {
                  name: "4";
                  tooltip-text: _("4 Stars");
                  icon-name: bind $format_rating_icon_name(template.model as <$NocturneModelAlbum> .userRating, 4);
                  clicked => $change_rating();
                  styles [
                    "flat"
                  ]
                }
                Gtk.Button {
                  name: "5";
                  tooltip-text: _("5 Stars");
                  icon-name: bind $format_rating_icon_name(template.model as <$NocturneModelAlbum> .userRating, 5);
                  clicked => $change_rating();
                  styles [
                    "flat"
                  ]
                }
              }

              Adw.WrapBox context_wrap_el {
                orientation: horizontal;
                line-spacing: 10;
                child-spacing: 10;

                Gtk.Button star_el {
                  styles [
                    "circular"
                  ]
                  accessibility {
                    label: _("Toggle star");
                  }

                  action-name: "app.toggle_star";
                  action-target: bind $format_action_target(template.model as <$NocturneModelAlbum> .id, 's');
                  icon-name: bind $format_starred_icon_name(template.model as <$NocturneModelAlbum> .starred);
                  tooltip-text: bind $format_starred_tooltip_text(template.model as <$NocturneModelAlbum> .starred);
                  valign: end;
                  halign: end;
                }
              }
            }
          }

          $NocturneSongQueue song_list_el {
            header-label: _("Songs");
            header-icon-name: "music-note-symbolic";
          }
        };
      };
    };
  };
}
