using Gtk 4.0;

template $NocturneSongSmallRow: Gtk.Button {
  Gtk.GestureClick {
    button: 3;
    released => $show_popover();
  }
  Gtk.GestureLongPress {
    pressed => $show_popover();
  }
  styles [
    "card",
    "p0"
  ]
  action-name: "app.play_song";
  action-target: bind $format_action_target(template.model as <$NocturneModelSong> .id, 's');
  name: bind template.model as <$NocturneModelSong> .title;
  tooltip-text: bind template.model as <$NocturneModelSong> .title;

  child: Gtk.Box {
    orientation: horizontal;
    spacing: 5;

    Gtk.Image cover_el {
      styles [
        "card"
      ]
      accessibility {
        label: _("Song cover art");
      }

      height-request: 48;
      width-request: 48;
      margin-top: 5;
      margin-bottom: 5;
      overflow: hidden;
      valign: center;
      halign: center;
      paintable: bind template.model as <$NocturneModelSong> .gdkPaintableSmall;
      pixel-size: bind $format_pixel_size(template.model as <$NocturneModelSong> .gdkPaintableSmall);
    }

    Gtk.Box {
      orientation: vertical;
      valign: center;

      Gtk.Label title_el {
        styles [
          "heading"
        ]
        wrap: true;
        wrap-mode: word_char;
        xalign: 0;
        label: bind template.model as <$NocturneModelSong> .title;
      }

      Gtk.Label subtitle_el {
        styles [
          "caption",
          "dimmed"
        ]
        wrap: true;
        wrap-mode: word_char;
        xalign: 0;
        label: bind $format_subtitle(template.model as <$NocturneModelSong> .album, template.model as <$NocturneModelSong> .artist, template.show-album-name);
      }
    }
  };
}