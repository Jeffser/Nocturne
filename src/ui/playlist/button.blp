using Gtk 4.0;
using Adw 1;

template $NocturnePlaylistButton: Gtk.Box {
  name: bind template.model as <$NocturneModelPlaylist> .name;

  Gtk.GestureClick {
    button: 3;
    released => $show_popover();
  }
  Gtk.GestureLongPress {
    pressed => $show_popover();
  }
  orientation: vertical;
  spacing: 5;
  halign: center;

  Gtk.Overlay {
    styles [
      "album-button"
    ]

    [overlay]
    Gtk.Button play_el {
      icon-name: "media-playback-start-symbolic";
      styles [
        "osd",
        "circular"
      ]
      tooltip-text: _("Play Playlist");
      action-target: bind $format_action_target(template.model as <$NocturneModelPlaylist> .id, 's');
      action-name: "app.play_playlist";
      valign: end;
      halign: start;
    }

    child: Gtk.Button cover_button_el {
      styles [
        "force_p0",
        "flat"
      ]
      action-target: bind $format_action_target(template.model as <$NocturneModelPlaylist> .id, 's');
      action-name: "app.show_playlist";
      halign: center;
      tooltip-text: bind template.model as <$NocturneModelPlaylist> .name;
      child: Gtk.Image cover_el {
        styles [
          "card"
        ]
        icon-size: large;
        overflow: hidden;
        hexpand: true;
        icon-name: "music-note-symbolic";
        paintable: bind $format_paintable(template.model as <$NocturneModelPlaylist> .gdkPaintable);
        accessibility {
          label: _("Playlist cover art");
        }
      };
    };
  }

  Gtk.Button name_el {
    styles [
      "flat",
      "p0"
    ]
    accessibility {
      label: _("Enter playlist page");
    }

    child: Gtk.Box {
      orientation: vertical;
      spacing: 5;
      Gtk.Label name_label_el {
        styles [
          "title-3"
        ]
        ellipsize: end;
        max-width-chars: 1;
        label: bind template.model as <$NocturneModelPlaylist> .name;
      }

      Gtk.Label song_count_label_el {
        styles [
          "dimmed"
        ]
        ellipsize: end;
        max-width-chars: 1;
        label: bind $format_song_count(template.model as <$NocturneModelPlaylist> .songCount);
        visible: bind $format_to_bool(template.model as <$NocturneModelPlaylist> .songCount);
      }
    };
    tooltip-text: bind template.model as <$NocturneModelPlaylist> .name;
    action-target: bind $format_action_target(template.model as <$NocturneModelPlaylist> .id, 's');
    action-name: "app.show_playlist";
  }
}