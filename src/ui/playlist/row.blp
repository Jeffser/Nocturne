using Gtk 4.0;
using Adw 1;

template $NocturnePlaylistRow: Adw.ActionRow {
  action-target: bind $format_action_target(template.model as <$NocturneModelPlaylist> .id, 's');
  action-name: "app.show_playlist";
  name: bind template.model as <$NocturneModelPlaylist> .name;
  title: bind template.model as <$NocturneModelPlaylist> .name;
  subtitle: bind $format_song_count(template.model as <$NocturneModelPlaylist> .songCount);

  activatable: true;
  use-markup: false;
  Gtk.GestureClick {
    button: 3;
    released => $show_popover();
  }
  Gtk.GestureLongPress {
    pressed => $show_popover();
  }

  [prefix]
  Gtk.Image cover_el {
    styles [
      "card"
    ]
    height-request: 48;
    width-request: 48;
    margin-top: 10;
    margin-bottom: 10;
    overflow: hidden;
    valign: center;
    halign: center;
    icon-name: "music-note-symbolic";
    pixel-size: bind $format_cover_pixel_size(template.model as <$NocturneModelPlaylist> .gdkPaintable);
    paintable: bind template.model as <$NocturneModelPlaylist> .gdkPaintable;
    accessibility {
      label: _("Playlist cover art");
    }
  }

  [suffix]
  Gtk.MenuButton menu_button_el {
    styles [
      "circular",
      "flat",
    ]
    icon-name: "view-more-symbolic";
    valign: center;
    notify::active => $on_context_button_active();
    popover: Gtk.Popover {
      child: Adw.Spinner {};
    };
    tooltip-text: _("Options");
  }
}