using Gtk 4.0;
using Adw 1;

template $NocturnePlaylistSelectorRow: Adw.ActionRow {
  title: bind template.model as <$NocturneModelPlaylist> .name;
  name: bind template.model as <$NocturneModelPlaylist> .name;
  tooltip-text: bind $format_tooltip_text(template.model as <$NocturneModelPlaylist> .name);
  subtitle: bind $format_song_count(template.model as <$NocturneModelPlaylist> .songCount);
  action-name: "app.add_songs_to_playlist";
  activatable: true;
  use-markup: false;
  [prefix]
  Gtk.Image cover_el {
    styles [
      "card"
    ]
    height-request: 48;
    width-request: 48;
    margin-top: 10;
    margin-bottom: 10;
    overflow: hidden;
    valign: center;
    halign: center;
    icon-name: "music-note-symbolic";
    paintable: bind template.model as <$NocturneModelPlaylist> .gdkPaintable;
    pixel-size: bind $format_paintable_pixel_size(template.model as <$NocturneModelPlaylist> .gdkPaintable);
    accessibility {
      label: _("Playlist cover art");
    }
  }
}