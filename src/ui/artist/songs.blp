using Gtk 4.0;
using Adw 1;

template $NocturneArtistSongsPage: Adw.NavigationPage {
  title: _("Songs");

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [end]
      Gtk.MenuButton filter_button {
        styles ["menu"]
        icon-name: "filter-symbolic";
        tooltip-text: _("Filter & Sort");
        menu-model: sort_menu;
      }

      title-widget: Gtk.SearchEntry search_entry_el {
        hexpand: true;
        key-capture-widget: main_stack;
        placeholder-text: bind template.title;
        search-changed => $on_search();
        accessibility {
          label: _("Search songs");
        }
      };
    }


    content: Gtk.Stack main_stack {
      transition-type: crossfade;
      Gtk.StackPage {
        name: "loading";
        child: Adw.Spinner {};
      }
      Gtk.StackPage {
        name: "content";
        child: Gtk.ScrolledWindow scrolledwindow {
          propagate-natural-width: true;
          propagate-natural-height: true;
          edge-reached => $scroll_edge_reached();

          child: Adw.Clamp {
            maximum-size: 2000;
            tightening-threshold: 800;

            Adw.Bin {
              $NocturneSongQueue list_el {
                styles [
                  "boxed-list",
                  "m10"
                ]
                valign: start;
              }
            }
          };
        };
      }
      Gtk.StackPage {
        name: "no-content";
        child: Adw.StatusPage failed_status_el {
          icon-name: "sad-computer-symbolic";
          title: _("No Items Found");
        };
      }
    };
  };
}

menu sort_menu {
  section{
    item {
      label: _("Favorites");
      action: "sort.favorites-only";
    }
  }

  section {
    label: _("Sort");
    item {
      label: _("Top Plays");
      action: "sort.sort-order";
      target: "playCount";
    }
    item {
      label: _("Name");
      action: "sort.sort-order";
      target: "title";
    }
    item {
      label: _("Album");
      action: "sort.sort-order";
      target: "album";
    }
    item {
      label: _("Random");
      action: "sort.sort-order";
      target: "random";
    }
  }
}
