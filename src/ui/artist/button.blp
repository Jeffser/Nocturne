using Gtk 4.0;
using Adw 1;

template $NocturneArtistButton: Gtk.Button {
  Gtk.GestureClick {
    button: 3;
    released => $show_popover();
  }
  Gtk.GestureLongPress {
    pressed => $show_popover();
  }
  styles [
    "flat"
  ]
  action-name: "app.show_artist";
  action-target: bind $format_action_target(template.model as <$NocturneModelArtist> .id, 's');
  tooltip-text: bind template.model as <$NocturneModelArtist> .name;
  name: bind template.model as <$NocturneModelArtist> .name;

  child: Gtk.Box {
    orientation: vertical;
    spacing: 5;

    Adw.Avatar avatar_el {
      custom-image: bind $format_gdkPaintable(template.model as <$NocturneModelArtist> .gdkPaintable);
      icon-name: "music-artist-symbolic";
    }

    Gtk.Label name_el {
      styles [
        "title-3"
      ]
      ellipsize: end;
      max-width-chars: 1;
      label: bind template.model as <$NocturneModelArtist> .name;
    }

    Gtk.Label album_count_el {
      styles [
        "dimmed"
      ]
      ellipsize: end;
      max-width-chars: 1;
      visible: bind $format_negative_bool(template.model as <$NocturneModelArtist> .albumCount);
      label: bind $format_album_count_label(template.model as <$NocturneModelArtist> .albumCount);
    }
  };
}